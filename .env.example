# ---------------------------------------------------------------------------
# Adaptive RAG Telecom Support Resolution Assistant - environment configuration
# Copy to .env and adjust. Secrets stay on the backend; never expose them to the frontend.
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# DEMO MODE works with no API keys (deterministic grounded templates).
# AI MODE requires DEMO_MODE=false AND a GEMINI_API_KEY.
DEMO_MODE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=25

# PostgreSQL + pgvector (docker-compose provides this). If unreachable, the app
# falls back to SQLite when DB_FALLBACK_TO_SQLITE=true.
DATABASE_URL=postgresql://telecom:telecom@localhost:5432/telecom_support
DB_FALLBACK_TO_SQLITE=true
PGVECTOR_ENABLED=true
# Local development without PostgreSQL:
# DATABASE_URL=sqlite:///./data/telecom_support.db

# Seed the database automatically on first start (SYNTHETIC / DEMO DATA)
AUTO_SEED=true
DATASET_PATH=./data/telecom_support_adaptive_60000.csv
DEMO_DATASET_PATH=./data/tickets.csv
KNOWLEDGE_BASE_PATH=./data/knowledge_base.csv

# Models (local, no API key needed). EMBEDDING_BACKEND: auto | sentence_transformers | hashing
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Evidence thresholds (single source of truth: backend/app/config.py)
KNOWN_THRESHOLD=0.70
UNKNOWN_THRESHOLD=0.45
MAX_RESOLUTION_ATTEMPTS=3

# Hybrid retrieval
TOP_K=10
SEMANTIC_WEIGHT=0.60
KEYWORD_WEIGHT=0.25
METADATA_WEIGHT=0.15

# Emerging issue discovery
EMERGING_SIMILARITY_THRESHOLD=0.62
EMERGING_MIN_CLUSTER_SIZE=3

# Security
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_REQUEST_BYTES=65536
MAX_COMPLAINT_CHARS=2000
